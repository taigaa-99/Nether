local function addGrad(o)
	if not o then return nil end
	local g = o:FindFirstChildOfClass("UIGradient")
	if not g then
		g = Instance.new("UIGradient")
		g.Parent = o
	end
	g.Color = ColorSequence.new(S.c1, S.c2)
	g.Rotation = 15
	table.insert(grads, g)
	return g
end

local function refreshTheme(nc1, nc2)
	S.c1 = nc1
	S.c2 = nc2
	for i = 1, #grads do
		local g = grads[i]
		if g and g.Parent then
			g.Color = ColorSequence.new(S.c1, S.c2)
		end
	end
end

local function trim(s)
	if not s then return "" end
	while #s > 0 and string.byte(s, 1) <= 32 do
		s = s:sub(2)
	end
	while #s > 0 and string.byte(s, -1) <= 32 do
		s = s:sub(1, -2)
	end
	return s
end

local function stripRich(s)
	if not s then return "" end
	if not s:find("<", 1, true) then return trim(s) end
	while true do
		local a = s:find("<", 1, true)
		if not a then break end
		local b = s:find(">", a, true)
		if not b then break end
		s = s:sub(1, a - 1) .. s:sub(b + 1)
	end
	return trim(s)
end

local function normLower(s)
	local r = tostring(s or "")
	r = r:gsub(string.char(196, 176), "i"):gsub(string.char(196, 177), "i")
	r = r:gsub(string.char(195, 156), "u"):gsub(string.char(195, 188), "u")
	r = r:gsub(string.char(195, 150), "o"):gsub(string.char(195, 182), "o")
	r = r:gsub(string.char(195, 135), "c"):gsub(string.char(195, 167), "c")
	r = r:gsub(string.char(197, 158), "s"):gsub(string.char(197, 159), "s")
	r = r:gsub(string.char(196, 158), "g"):gsub(string.char(196, 159), "g")
	return r:lower()
end

