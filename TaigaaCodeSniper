local function getGuiRoot()
	local ok, hui = pcall(function()
		return gethui and gethui() or nil
	end)
	if ok and hui then
		return hui
	end
	local okCg, _ = pcall(function()
		return CG:GetChildren()
	end)
	if okCg then
		return CG
	end
	return pg
end

local guiParent = getGuiRoot()

local function cleanupOld()
	local names = { "TaigaHubGui", "TaigaExternalGui", "SaintHubGui", "NexisConsoleGui" }
	for _, root in ipairs({ guiParent, pg, CG }) do
		pcall(function()
			for _, nm in ipairs(names) do
				local found = root:FindFirstChild(nm)
				if found then
					found:Destroy()
				end
			end
		end)
	end
end

