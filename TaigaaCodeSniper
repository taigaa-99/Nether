local function isBannedText(s)
	if not s or s == "" then return true end
	local compact = normLower(s):gsub("%s+", "")
	if compact == "mimiche"
		or compact == "mimicheai"
		or compact == "aimimiche"
		or compact == "usecode"
		or compact == "system"
		or compact == "admin" then
		return true
	end
	return false
end

local function getAllCodeBoxes()
	local boxes = {}
	local codes = pg:FindFirstChild("Codes")
	if codes then
		for _, e in ipairs(codes:GetDescendants()) do
			if e:IsA("TextBox") then table.insert(boxes, e) end
		end
		if #boxes > 0 then return boxes end
	end
	for _, g in ipairs(pg:GetChildren()) do
		if g:IsA("ScreenGui") and g ~= sg and g ~= extSg then
			for _, e in ipairs(g:GetDescendants()) do
				if e:IsA("TextBox") and e.TextEditable then
					local key = normLower((e.PlaceholderText or "") .. " " .. e.Name .. " " .. (e.Parent and e.Parent.Name or "") .. " " .. g.Name)
					if key:find("code", 1, true) or key:find("kod", 1, true) or key:find("redeem", 1, true) then
						table.insert(boxes, e)
					end
				end
			end
		end
	end
	return boxes
end

local function syncTargetBox(txt)
	if setclipboard then
		pcall(function() setclipboard(txt) end)
	end
	local boxes = getAllCodeBoxes()
	for i = 1, #boxes do
		pcall(function()
			boxes[i].Text = ""
			boxes[i].Text = txt
		end)
	end
end

local function applyDirectCode(fullCode)
	if not fullCode or fullCode == "" or isBannedText(fullCode) then return end
	table.clear(S.parts)
	table.insert(S.parts, fullCode)
	S.merged = fullCode
	bufLbl.Text = "CODE (DIRECT): " .. S.merged
	syncTargetBox(S.merged)
end

local function applyCode(codeText)
	if not codeText or codeText == "" then return end
	local cleanPart = codeText:gsub("%s+", "")
	if cleanPart == "" or isBannedText(cleanPart) then return end
	table.insert(S.parts, cleanPart)
	S.merged = table.concat(S.parts, "")
	bufLbl.Text = "CODE (" .. #S.parts .. "): " .. S.merged
	syncTargetBox(S.merged)
end

